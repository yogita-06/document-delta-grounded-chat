APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
LLM_PROVIDER=mock
LLM_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
TESSERACT_CMD=
OCR_MIN_CONFIDENCE=0.50
PAGE_ALIGNMENT_MIN_SCORE=0.55
ELEMENT_ALIGNMENT_MIN_SCORE=0.62
MODIFICATION_TEXT_THRESHOLD=0.94
MOVE_DISTANCE_THRESHOLD=0.15
MAX_UPLOAD_MB=25
OCR_DPI=300
LOG_LEVEL=INFO
